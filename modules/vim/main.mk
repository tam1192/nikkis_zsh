# ==============================================================================
# Module: Vim
# ==============================================================================

MOD_VIM      := vim
MOD_VIM_DIR  := $(MODULES_DIR)/$(MOD_VIM)
MOD_VIM_MAIN := $(MOD_VIM_DIR)/src/alias.sh

# ------------------------------------------------------------------------------
# Build Rules
# ------------------------------------------------------------------------------

# 必須: main.sh の生成
$(MOD_VIM_DIR)/main.sh: $(MOD_VIM_MAIN)
	@cat $^ > $@

# 必須: 空ファイルの初期化 (touch ではなく > $@ にすることでクリアを保証)
$(MOD_VIM_DIR)/main.var:
	@> $@

$(MOD_VIM_DIR)/main.env:
	@> $@

# ------------------------------------------------------------------------------
# Phonies & Clean
# ------------------------------------------------------------------------------
.PHONY: vim-clean

# 必須: クリーン処理 (存在しないファイルがあってもエラーにならないよう -f を付与)
vim-clean:
	@rm -f $(MOD_VIM_DIR)/main.sh $(MOD_VIM_DIR)/main.var $(MOD_VIM_DIR)/main.env