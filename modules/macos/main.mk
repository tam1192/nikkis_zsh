# ==============================================================================
# Module: Basic
# ==============================================================================

MOD_MACOS      := macos
MOD_MACOS_DIR  := $(MODULES_DIR)/$(MOD_MACOS)
MOD_MACOS_MAIN := $(MOD_MACOS_DIR)/src/main.sh 

# ------------------------------------------------------------------------------
# Build Rules
# ------------------------------------------------------------------------------

# 必須: main.sh の生成
$(MOD_MACOS_DIR)/main.sh: $(MOD_MACOS_MAIN)
	@cat $^ > $@

# 必須: 空ファイルの初期化 (touch ではなく > $@ にすることでクリアを保証)
$(MOD_MACOS_DIR)/main.var:
	@> $@

$(MOD_MACOS_DIR)/main.env:
	@> $@

# ------------------------------------------------------------------------------
# Phonies & Clean
# ------------------------------------------------------------------------------
.PHONY: macos-clean

# 必須: クリーン処理 (存在しないファイルがあってもエラーにならないよう -f を付与)
macos-clean:
	@rm -f $(MOD_MACOS_DIR)/main.sh $(MOD_MACOS_DIR)/main.var $(MOD_MACOS_DIR)/main.env